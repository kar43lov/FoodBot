# Telegram Bot
BOT_TOKEN=your_telegram_bot_token_here
WEBHOOK_URL=https://your-domain.com/webhook
APP_URL=https://your-domain.com

# Database
# For development (SQLite): use prisma/schema.prisma
# For production (PostgreSQL): use prisma/schema.prod.prisma
# PostgreSQL for production:
# DATABASE_URL=postgresql://user:password@localhost:5432/foodbot?schema=public
# SQLite for development:
DATABASE_URL=file:./dev.db

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
AI_FOOD_CONFIDENCE_THRESHOLD=0.6

# Application
MODE=dev
LOG_LEVEL=info
TZ=Europe/Moscow

# Server (for API)
PORT=3000
HOST=0.0.0.0
