# Telegram Bot
BOT_TOKEN=your_telegram_bot_token_here
BOT_NAME=your_bot_username_here
WEBHOOK_URL=https://your-domain.com/webhook
APP_URL=https://your-domain.com

# Database
# For development (SQLite): use prisma/schema.prisma
# For production (PostgreSQL): use prisma/schema.prod.prisma
# PostgreSQL for production:
# DATABASE_URL=postgresql://user:password@localhost:5432/foodbot?schema=public
# SQLite for development:
DATABASE_URL=file:./dev.db

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
AI_FOOD_CONFIDENCE_THRESHOLD=0.6

# Access control
SUPER_ADMIN_ID=your_telegram_user_id_here

# Application
MODE=dev
LOG_LEVEL=info
TZ=Europe/Moscow

# Server (for API)
PORT=3000
HOST=0.0.0.0

# Web App (frontend environment variables)
# VITE_API_URL=http://localhost:3000
# VITE_BOT_NAME=your_bot_username
