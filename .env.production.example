# FoodBot Production Environment
# Copy to .env and fill in real values:
#   cp .env.production.example .env

# === Telegram Bot ===
BOT_TOKEN=your_bot_token_from_botfather
BOT_NAME=YourBotUsername

# Webhook (your domain with HTTPS)
WEBHOOK_URL=https://your-domain.com/webhook
APP_URL=https://your-domain.com

# === Access Control ===
SUPER_ADMIN_ID=your_telegram_user_id

# === OpenAI ===
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o
AI_FOOD_CONFIDENCE_THRESHOLD=0.6

# === PostgreSQL (must match docker-compose.yml) ===
POSTGRES_USER=foodbot
POSTGRES_PASSWORD=change_this_to_a_strong_password
POSTGRES_DB=foodbot

# === Application ===
MODE=prod
LOG_LEVEL=info
TZ=Europe/Moscow
PORT=3000
